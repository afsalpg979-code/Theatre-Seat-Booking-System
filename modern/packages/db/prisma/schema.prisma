generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  roles UserRole[]
  bookings Booking[]
  refreshTokens RefreshToken[]
}
model Role {
  id String @id @default(cuid())
  name String @unique
  permissions RolePermission[]
  users UserRole[]
}
model Permission {
  id String @id @default(cuid())
  name String @unique
  roles RolePermission[]
}
model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}
model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}
model RefreshToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Theatre {
  id        String   @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  screens   Screen[]
  shows     Show[]
}

model Screen {
  id        String   @id @default(cuid())
  theatreId String
  name      String
  capacity  Int
  theatre   Theatre  @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  seats     Seat[]
  shows     Show[]
}

model Seat {
  id        String @id @default(cuid())
  screenId  String
  row       String
  number    Int
  category  String @default("STANDARD")
  screen    Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  bookings BookingSeat[]
  seatLocks SeatLock[]
  @@unique([screenId, row, number])
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  description String?
  durationMin Int
  language    String?
  releaseDate DateTime?
  shows       Show[]
  createdAt   DateTime @default(now())
}

model Show {
  id        String   @id @default(cuid())
  theatreId String
  screenId  String
  movieId   String
  startsAt  DateTime
  basePrice Decimal @db.Decimal(10, 2)
  theatre   Theatre  @relation(fields: [theatreId], references: [id])
  screen    Screen   @relation(fields: [screenId], references: [id])
  movie     Movie    @relation(fields: [movieId], references: [id])
  bookings Booking[]
  seatLocks SeatLock[]
  @@index([screenId, startsAt])
}

model SeatLock {
  id String @id @default(cuid())
  showId String
  seatId String
  token String @unique
  expiresAt DateTime
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  @@unique([showId, seatId])
  @@index([expiresAt])
}

model Booking {
  id        String        @id @default(cuid())
  bookingCode String @unique
  showId    String
  userId String?
  customerName String
  customerEmail String?
  status    BookingStatus @default(PENDING)
  total     Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  show      Show          @relation(fields: [showId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  seats     BookingSeat[]
  payments Payment[]
  ticket Ticket?
  @@index([showId, status])
}

model BookingSeat {
  id        String  @id @default(cuid())
  bookingId String
  seatId    String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat      Seat    @relation(fields: [seatId], references: [id])
  @@unique([bookingId, seatId])
}

model Payment {
  id String @id @default(cuid())
  bookingId String
  method PaymentMethod
  status PaymentStatus @default(CREATED)
  amount Decimal @db.Decimal(10, 2)
  providerRef String?
  createdAt DateTime @default(now())
  paidAt DateTime?
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, status])
}

model Ticket {
  id String @id @default(cuid())
  bookingId String @unique
  qrToken String @unique
  status TicketStatus @default(VALID)
  issuedAt DateTime @default(now())
  usedAt DateTime?
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
\n
enum InventoryTxnType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  WASTE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FinanceEntryType {
  INCOME
  EXPENSE
  REFUND
  TRANSFER
}

model Product {
  id String @id @default(cuid())
  name String
  sku String @unique
  category String?
  unit String @default("PCS")
  sellingPrice Decimal @db.Decimal(10,2)
  costPrice Decimal @db.Decimal(10,2)
  stockQty Int @default(0)
  reorderLevel Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  inventoryTransactions InventoryTransaction[]
  purchaseItems PurchaseItem[]
  posItems PosItem[]
}

model InventoryTransaction {
  id String @id @default(cuid())
  productId String
  type InventoryTxnType
  quantity Int
  unitCost Decimal? @db.Decimal(10,2)
  referenceType String?
  referenceId String?
  notes String?
  createdAt DateTime @default(now())
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@index([productId,createdAt])
}

model Supplier {
  id String @id @default(cuid())
  name String
  phone String?
  email String?
  address String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id String @id @default(cuid())
  orderNo String @unique
  supplierId String
  status PurchaseOrderStatus @default(DRAFT)
  total Decimal @db.Decimal(10,2)
  orderedAt DateTime?
  receivedAt DateTime?
  createdAt DateTime @default(now())
  supplier Supplier @relation(fields:[supplierId],references:[id])
  items PurchaseItem[]
  @@index([supplierId,status])
}

model PurchaseItem {
  id String @id @default(cuid())
  purchaseOrderId String
  productId String
  quantity Int
  unitCost Decimal @db.Decimal(10,2)
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id])
}

model PosSale {
  id String @id @default(cuid())
  saleNo String @unique
  userId String?
  subtotal Decimal @db.Decimal(10,2)
  tax Decimal @db.Decimal(10,2) @default(0)
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  items PosItem[]
  @@index([createdAt])
}

model PosItem {
  id String @id @default(cuid())
  saleId String
  productId String
  quantity Int
  unitPrice Decimal @db.Decimal(10,2)
  sale PosSale @relation(fields:[saleId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id])
}

model Department {
  id String @id @default(cuid())
  name String @unique
  employees Employee[]
}

model Employee {
  id String @id @default(cuid())
  employeeNo String @unique
  name String
  email String?
  phone String?
  departmentId String?
  designation String?
  status EmployeeStatus @default(ACTIVE)
  joinedAt DateTime?
  department Department? @relation(fields:[departmentId],references:[id],onDelete:SetNull)
  attendance EmployeeAttendance[]
  shifts EmployeeShift[]
  maintenanceRequests MaintenanceRequest[]
  @@index([departmentId,status])
}

model EmployeeShift {
  id String @id @default(cuid())
  employeeId String
  shiftDate DateTime
  startTime String
  endTime String
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade)
  @@index([employeeId,shiftDate])
}

model EmployeeAttendance {
  id String @id @default(cuid())
  employeeId String
  attendanceDate DateTime
  status AttendanceStatus
  checkIn DateTime?
  checkOut DateTime?
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade)
  @@unique([employeeId,attendanceDate])
}

model Asset {
  id String @id @default(cuid())
  assetCode String @unique
  name String
  category String?
  location String?
  purchaseDate DateTime?
  purchaseCost Decimal? @db.Decimal(10,2)
  active Boolean @default(true)
  maintenanceRequests MaintenanceRequest[]
}

model MaintenanceRequest {
  id String @id @default(cuid())
  assetId String
  employeeId String?
  title String
  description String?
  status MaintenanceStatus @default(OPEN)
  cost Decimal? @db.Decimal(10,2)
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Cascade)
  employee Employee? @relation(fields:[employeeId],references:[id],onDelete:SetNull)
  @@index([assetId,status])
}

model FinanceEntry {
  id String @id @default(cuid())
  entryNo String @unique
  type FinanceEntryType
  category String
  amount Decimal @db.Decimal(12,2)
  description String?
  referenceType String?
  referenceId String?
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([entryDate,type])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  module String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([module,createdAt])
}

enum UserStatus { ACTIVE INACTIVE SUSPENDED }
enum PaymentStatus { CREATED PENDING PAID FAILED REFUNDED }
enum PaymentMethod { CASH CARD UPI RAZORPAY }
enum TicketStatus { VALID USED CANCELLED EXPIRED }


enum AiQueryType {
  GENERAL
  SALES_FORECAST
  DEMAND_FORECAST
  INVENTORY_ALERT
  OCCUPANCY_ANALYSIS
  BUSINESS_INSIGHT
}

model AiQuery {
  id String @id @default(cuid())
  userId String?
  type AiQueryType
  prompt String
  response String?
  createdAt DateTime @default(now())
  @@index([type,createdAt])
}

model AiPrediction {
  id String @id @default(cuid())
  type String
  targetDate DateTime?
  metric String
  predictedValue Decimal? @db.Decimal(14,2)
  confidence Decimal? @db.Decimal(5,4)
  explanation String?
  createdAt DateTime @default(now())
  @@index([type,targetDate])
}
